NEXT_PUBLIC_SITE_URL=https://www.dublingolfshow.ie

# Resend (https://resend.com) — required for Register Interest emails
RESEND_API_KEY=
# Optional — defaults to onboarding@resend.dev until a domain is verified
RESEND_FROM_EMAIL=Dublin Golf Show <onboarding@resend.dev>
# Where interest submissions are delivered (defaults to shane@dublingolfshow.ie)
INTEREST_NOTIFY_EMAIL=shane@dublingolfshow.ie
# Optional — defaults to INTEREST_NOTIFY_EMAIL
PARTNER_NOTIFY_EMAIL=shane@dublingolfshow.ie

# Supabase — production project.
# Anon key is required for admin cookie sessions. Never put the service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by some Supabase dashboards
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role: enquiry APIs and hashed booking-invite redemption. Never expose to the browser.
# Admin UI must use the cookie session + anon key.
SUPABASE_SERVICE_ROLE_KEY=
